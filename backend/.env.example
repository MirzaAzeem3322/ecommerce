# Copy this file to .env and fill in your values

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

PORT=5000

# Long random string used to sign login tokens. Change this!
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Where the Next.js frontend runs (used for CORS and Stripe redirect URLs)
CLIENT_URL="http://localhost:3000"

# Currency for Stripe payments (lowercase ISO code, e.g. usd, pkr, eur)
CURRENCY="usd"

# Optional: Stripe card payments. Leave empty to offer Cash on Delivery only.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Admin account created by the seed script
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123"
